+            raise ValueError(f"Invalid sample_id {sid!r} in manifest record: {rec}")
+        if sid in seen_ids or sid < 0 or sid >= n_expected:
+            raise ValueError(f"Duplicate or out-of-range sample_id {sid} in manifest")
+        seen_ids.add(sid)
