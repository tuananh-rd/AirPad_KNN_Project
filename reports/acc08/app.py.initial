"""
AirPad Virtual Mouse - CLI Entrypoint.

Usage:
  python app.py --self-check
  python app.py --replay fixtures/synthetic_replay.json
  python app.py --camera [--real-control]
"""
from __future__ import annotations

import argparse
import json
import logging
import os
import sys
import time
from typing import Optional, List, Dict, Any

import numpy as np

from src.config.loader import load_config
from src.gesture.fsm import GestureFSM, FSMState
from src.gesture.pose import HandPose
from src.gesture.temporal import MajorityFilter, StabilityGate
from src.ml.classifier import PoseClassifier
from src.ml.bundle import ModelBundle
from src.motion.cursor import CursorMapper
from src.motion.scroll import ScrollEngine
from src.motion.zoom import ZoomEngine
from src.motion.swipe import SwipeEngine
from src.platform.dry_run import DryRunController
from src.platform.interface import PlatformController
from src.runtime.pipeline import AirPadPipeline, PipelineResult

logging.basicConfig(level=logging.INFO, format="%(asctime)s [%(levelname)s] %(message)s")
logger = logging.getLogger("airpad")


WARNING_BANNER = """
======================================================================
[WARNING] REAL OS CONTROL IS ENABLED (--real-control)
Hand gestures will move your actual mouse cursor and click!
Emergency Stop: Press Ctrl+Alt+Q or push cursor into screen corner.
======================================================================
"""


def create_pipeline(
    config: dict,
    allow_real_control: bool = False,
    model_bundle: Optional[ModelBundle] = None,
) -> AirPadPipeline:
    """Build a fully-configured AirPadPipeline instance."""
    controller: PlatformController
    if allow_real_control:
        print(WARNING_BANNER)
        from src.platform.windows import WindowsController
        controller = WindowsController(allow_real_control=True)
    else:
        controller = DryRunController()

    gesture_cfg = config.get("gesture", {})
    motion_cfg = config.get("motion", {})

    fsm = GestureFSM(controller, gesture_cfg)
    cursor_mapper = CursorMapper(
        roi_x_min=motion_cfg.get("roi_x_min", 0.1),
        roi_x_max=motion_cfg.get("roi_x_max", 0.9),
        roi_y_min=motion_cfg.get("roi_y_min", 0.1),
        roi_y_max=motion_cfg.get("roi_y_max", 0.9),
        mirror_x=motion_cfg.get("mirror_x", True),
        dead_zone=motion_cfg.get("dead_zone", 0.002),
        gain_x=motion_cfg.get("gain_x", 1.0),
        gain_y=motion_cfg.get("gain_y", 1.0),
        filter_type=motion_cfg.get("filter_type", "one_euro"),
    )
    scroll_engine = ScrollEngine(
        dead_zone=motion_cfg.get("scroll_dead_zone", 0.005),
        gain=motion_cfg.get("scroll_gain", 120.0),
        axis_lock_ratio=motion_cfg.get("scroll_axis_lock_ratio", 1.2),
    )
    zoom_engine = ZoomEngine(
        step_threshold=motion_cfg.get("zoom_step_threshold", 0.035),
        cooldown_ms=motion_cfg.get("zoom_cooldown_ms", 80.0),
    )
    swipe_engine = SwipeEngine(
        min_displacement=motion_cfg.get("swipe_min_displacement", 0.08),
        min_velocity=motion_cfg.get("swipe_min_velocity", 0.0003),
        cooldown_ms=motion_cfg.get("swipe_cooldown_ms", 400.0),
    )
    majority_filter = MajorityFilter(
        window_size=gesture_cfg.get("stability_window", 5),
        majority_ratio=gesture_cfg.get("majority_ratio", 0.6),
    )
    stability_gate = StabilityGate(
        required_count=gesture_cfg.get("reacquire_stable_frames", 2)
    )

    safety_cfg = config.get("safety", {})
    rate_limiter = None
    if safety_cfg.get("max_events_per_second"):
        from src.safety.failsafe import RateLimiter
        rate_limiter = RateLimiter(int(safety_cfg["max_events_per_second"]))

    failsafe_monitor = None
    if safety_cfg.get("failsafe_corner", True):
        from src.safety.failsafe import FailsafeMonitor
        try:
            sw, sh = controller.get_screen_size()
        except Exception:
            sw, sh = 1920, 1080
        failsafe_monitor = FailsafeMonitor(screen_width=sw, screen_height=sh, corner_size=15)

    emergency_hotkey = None
    hotkey_str = safety_cfg.get("emergency_hotkey", "ctrl+alt+q")
    if hotkey_str:
        from src.safety.failsafe import EmergencyHotkey
        emergency_hotkey = EmergencyHotkey(
            hotkey=hotkey_str,
            callback=lambda: None,
            dry_run=not allow_real_control,
        )

    classifier: Optional[PoseClassifier] = None
    if model_bundle is not None:
        from tools.train import load_model_from_bundle
        classifier, _, _ = load_model_from_bundle(model_bundle)

    return AirPadPipeline(
        config=config,
        controller=controller,
        model_bundle=model_bundle,
        classifier=classifier,
        cursor_mapper=cursor_mapper,
        scroll_engine=scroll_engine,
        zoom_engine=zoom_engine,
        swipe_engine=swipe_engine,
        fsm=fsm,
        majority_filter=majority_filter,
        stability_gate=stability_gate,
        rate_limiter=rate_limiter,
        failsafe_monitor=failsafe_monitor,
        emergency_hotkey=emergency_hotkey,
    )


def run_self_check() -> int:
    """Run internal end-to-end self-check without webcam or external dependencies.

    Returns:
        0 on success, 1 on failure.
    """
    print("Running AirPad RBF-SVM self-check...")
    try:
        config = load_config()
        print("  [1/5] Configuration loaded and schema-validated successfully.")

        # Build the self-check model from the replay's own static-pose frames so
        # the end-to-end check exercises canonicalization, scaling and SVM inference.
        from tools.train import create_model_bundle
        from src.features.canonicalize import canonicalize
        fixture_path = os.path.join(
            os.path.dirname(__file__), "fixtures", "synthetic_replay.json"
        )
        if not os.path.exists(fixture_path):
            raise FileNotFoundError(f"Synthetic fixture not found at {fixture_path}")
        with open(fixture_path, "r", encoding="utf-8") as f:
            frames = json.load(f)
        training_frames = [frame for frame in frames if frame.get("landmarks")]
        dummy_X = np.asarray([
            canonicalize(np.asarray(frame["landmarks"]), frame.get("handedness", "Right")).reshape(-1)
            for frame in training_frames
        ])
        dummy_y = [frame["pose"] for frame in training_frames]
        bundle = create_model_bundle(
            X=dummy_X,
            y=dummy_y,
            C=10.0,
            gamma="scale",
            validation_metrics={"macro_f1": 1.0},
        )
        print("  [2/5] Mock ModelBundle generated (feature_version=1).")

        pipeline = create_pipeline(config, allow_real_control=False, model_bundle=bundle)
        print("  [3/5] AirPadPipeline initialized with DryRunController.")

        # Replay synthetic frames
        for frame in frames:
            landmarks = (
                np.array(frame["landmarks"])
                if frame.get("landmarks") is not None and len(frame["landmarks"]) > 0
                else None
            )
            pipeline.process_landmarks(
                landmarks=landmarks,
                handedness=frame.get("handedness", "Right"),
                timestamp_ms=float(frame.get("timestamp_ms", 0.0)),
            )

        print(f"  [4/5] Processed {len(frames)} synthetic replay frames without errors.")

        # Verify controller log
        ctrl = pipeline.controller
        assert isinstance(ctrl, DryRunController)
        assert len(ctrl.event_log) > 0, "No platform events were generated during replay"
        pipeline.cleanup()
        assert len(ctrl.held_buttons) == 0, "Held buttons not cleared after cleanup"
        print("  [5/5] Pipeline cleanup verified; all held keys/buttons released.")

        print("\nAll self-checks PASSED. AirPad RBF-SVM core is operational.")
        return 0
    except Exception as e:
        logger.error(f"Self-check failed: {e}", exc_info=True)
        return 1


def run_replay(fixture_path: str, allow_real_control: bool = False, model_path: Optional[str] = None) -> int:
    """Replay landmark frames from a JSON or NPZ fixture file."""
    if not os.path.exists(fixture_path):
        logger.error(f"Fixture file does not exist: {fixture_path}")
        return 1

    config = load_config()
    if model_path is None and os.path.exists("models/airpad_svm.json"):
        model_path = "models/airpad_svm.json"

    bundle: Optional[ModelBundle] = None
    if model_path and os.path.exists(model_path):
        from tools.train import load_bundle
        bundle = load_bundle(model_path)

    pipeline = create_pipeline(config, allow_real_control=allow_real_control, model_bundle=bundle)

    print(f"Replaying fixture: {fixture_path}")
    frames: List[Dict[str, Any]] = []

    if fixture_path.endswith(".json"):
        with open(fixture_path, "r", encoding="utf-8") as f:
            frames = json.load(f)
    elif fixture_path.endswith(".npz"):
        data = np.load(fixture_path, allow_pickle=True)
        features = data["features"]
        labels = data["labels"]
        # Convert flat features (63) back to dummy landmarks (21, 3) for replay
        for i in range(len(features)):
            frames.append({
                "frame_index": i,
                "timestamp_ms": i * 33.3,
                "landmarks": features[i].reshape(21, 3).tolist(),
                "handedness": "Right",
            })
    else:
        logger.error("Unsupported fixture format; must be .json or .npz")
        return 1

    events_count = 0
    try:
        for frame in frames:
            landmarks = (
                np.array(frame["landmarks"])
                if frame.get("landmarks") is not None and len(frame["landmarks"]) > 0
                else None
            )
            res = pipeline.process_landmarks(
                landmarks=landmarks,
                handedness=frame.get("handedness", "Right"),
                timestamp_ms=float(frame.get("timestamp_ms", 0.0)),
            )
            if res.action_fired:
                events_count += 1
                print(f"  [t={frame.get('timestamp_ms', 0):.0f}ms] Pose: {res.filtered_pose.name:<15} FSM: {res.fsm_state.name:<10} Action: {res.action_fired}")

        print(f"\nReplay complete. Processed {len(frames)} frames, emitted {events_count} action events.")
        return 0
    finally:
        pipeline.cleanup()


def run_camera(allow_real_control: bool = False, model_path: Optional[str] = None) -> int:
    """Run live camera loop with MediaPipe hand detection."""
    try:
        import cv2
    except ImportError:
        print("\n[ERROR] Camera preview requires 'opencv-python'.")
        print("Install with: pip install opencv-python or pip install .[camera]\n")
        return 1

    try:
        import mediapipe
    except ImportError:
        print("\n[ERROR] Hand detection requires 'mediapipe'.")
        print("Install with: pip install mediapipe or pip install .[vision]\n")
        return 1

    from src.vision.adapter import MediaPipeAdapter

    config = load_config()
    if model_path is not None:
        if not os.path.exists(model_path):
            print(f"\n[ERROR] Model file not found at: {model_path}\n")
            return 1
    elif os.path.exists("models/airpad_svm.json"):
        model_path = "models/airpad_svm.json"

    bundle: Optional[ModelBundle] = None
    if model_path and os.path.exists(model_path):
        from tools.train import load_bundle
        bundle = load_bundle(model_path)

    pipeline: Optional[AirPadPipeline] = None
    detector: Optional[MediaPipeAdapter] = None
    cap: Optional[Any] = None

    primary_exc: Optional[BaseException] = None
    cleanup_exceptions: List[Exception] = []

    try:
        pipeline = create_pipeline(config, allow_real_control=allow_real_control, model_bundle=bundle)
        detector = MediaPipeAdapter(static_image_mode=False, max_num_hands=1)

        cap = cv2.VideoCapture(0)
        if not cap.isOpened():
            print("[ERROR] Could not open webcam device index 0.")
            return 1

        print("\nAirPad live camera loop started. Press ESC to quit.\n")
        prev_time = time.time()

        while True:
            ret, frame = cap.read()
            if not ret or frame is None:
                break

            # Mirror view for natural interaction
            flipped_bgr = cv2.flip(frame, 1)
            h, w, _ = flipped_bgr.shape
            timestamp_ms = time.time() * 1000.0

            # Hand detection requires RGB, but OpenCV provides BGR
            rgb_frame = cv2.cvtColor(flipped_bgr, cv2.COLOR_BGR2RGB)
            detected_hands = detector.detect(rgb_frame)
            landmarks_np: Optional[np.ndarray] = None
            handedness = "Right"

            if detected_hands:
                hand = detected_hands[0]
                landmarks_np = hand.to_numpy()
                handedness = hand.handedness

                lms_pts = hand.points
                connections = [
                    (0, 1), (1, 2), (2, 3), (3, 4),
                    (0, 5), (5, 6), (6, 7), (7, 8),
                    (0, 9), (9, 10), (10, 11), (11, 12),
                    (0, 13), (13, 14), (14, 15), (15, 16),
                    (0, 17), (17, 18), (18, 19), (19, 20),
                    (5, 9), (9, 13), (13, 17),
                ]
                for p1, p2 in connections:
                    pt1 = (int(lms_pts[p1].x * w), int(lms_pts[p1].y * h))
                    pt2 = (int(lms_pts[p2].x * w), int(lms_pts[p2].y * h))
                    cv2.line(flipped_bgr, pt1, pt2, (255, 200, 0), 1)
                for pt in lms_pts:
                    px, py = int(pt.x * w), int(pt.y * h)
                    cv2.circle(flipped_bgr, (px, py), 4, (0, 255, 0), -1)

            res = pipeline.process_landmarks(landmarks_np, handedness=handedness, timestamp_ms=timestamp_ms)

            # FPS calculation
            curr_time = time.time()
            fps = 1.0 / (curr_time - prev_time + 1e-6)
            prev_time = curr_time

            # Status Overlay
            cv2.putText(flipped_bgr, f"FPS: {fps:.1f}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
            cv2.putText(flipped_bgr, f"Pose: {res.filtered_pose.name}", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 255, 0), 2)
            cv2.putText(flipped_bgr, f"FSM: {res.fsm_state.name}", (10, 90), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
            if res.action_fired:
                cv2.putText(flipped_bgr, f"Action: {res.action_fired}", (10, 120), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)
            if pipeline.is_emergency_stopped:
                cv2.putText(flipped_bgr, "EMERGENCY STOPPED! (Ctrl+Alt+Q / Corner)", (10, 150), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

            # Draw active ROI
            motion_cfg = config.get("motion", {})
            rx1 = int(motion_cfg.get("roi_x_min", 0.1) * w)
            rx2 = int(motion_cfg.get("roi_x_max", 0.9) * w)
            ry1 = int(motion_cfg.get("roi_y_min", 0.1) * h)
            ry2 = int(motion_cfg.get("roi_y_max", 0.9) * h)
            cv2.rectangle(flipped_bgr, (rx1, ry1), (rx2, ry2), (255, 128, 0), 1)

            cv2.imshow("AirPad Virtual Pad", flipped_bgr)
            key = cv2.waitKey(1) & 0xFF
            if key in (27, ord('q')):  # ESC or q
                break

        return 0
    except BaseException as e:
        primary_exc = e
        raise
    finally:
        if detector is not None and hasattr(detector, "close"):
            try:
                detector.close()
            except Exception as e:
                logger.warning(f"Error during detector cleanup: {e}")
                cleanup_exceptions.append(e)
        if pipeline is not None and hasattr(pipeline, "cleanup"):
            try:
                pipeline.cleanup()
            except Exception as e:
                logger.warning(f"Error during pipeline cleanup: {e}")
                cleanup_exceptions.append(e)
        if cap is not None and hasattr(cap, "release"):
            try:
                cap.release()
            except Exception as e:
                logger.warning(f"Error releasing camera: {e}")
                cleanup_exceptions.append(e)
        try:
            cv2.destroyAllWindows()
        except Exception as e:
            logger.warning(f"Error destroying windows: {e}")
            cleanup_exceptions.append(e)

        if primary_exc is None and cleanup_exceptions:
            raise cleanup_exceptions[0]


def main(args: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(description="AirPad Virtual Mouse Pad (Windows-first)")
    parser.add_argument("--self-check", action="store_true", help="Run internal self-check without webcam")
    parser.add_argument("--replay", type=str, metavar="FIXTURE", help="Replay landmark sequence from JSON/NPZ fixture")
    parser.add_argument("--camera", action="store_true", help="Run live camera preview with MediaPipe tracking")
    parser.add_argument("--real-control", action="store_true", help="Enable actual Windows OS mouse/keyboard control")
    parser.add_argument("--model", type=str, metavar="PATH", help="Path to trained ModelBundle JSON file")

    parsed = parser.parse_args(args)

    if parsed.self_check:
        return run_self_check()
    elif parsed.replay:
        return run_replay(parsed.replay, allow_real_control=parsed.real_control, model_path=parsed.model)
    elif parsed.camera:
        return run_camera(allow_real_control=parsed.real_control, model_path=parsed.model)
    else:
        parser.print_help()
        return 0


if __name__ == "__main__":
    sys.exit(main())
